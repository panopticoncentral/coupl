{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Coupl",
  "scopeName": "source.coupl",
  "patterns": [
    {
      "name": "comment.line.double-slash.coupl",
      "begin": "//",
      "end": "$"
    },
    {
      "name": "string.quoted.triple.coupl",
      "begin": "\"\"\"",
      "end": "\"{3,5}"
    },
    {
      "name": "string.quoted.double.coupl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.coupl",
          "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9A-Fa-f]{4})"
        }
      ]
    },
    {
      "name": "constant.language.boolean.coupl",
      "match": "\\b(?:true|false)\\b"
    },
    {
      "name": "constant.numeric.coupl",
      "match": "(?<![\\w.])-?\\b(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b"
    },
    {
      "name": "entity.name.function.coupl",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    {
      "name": "variable.parameter.coupl",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*=)"
    },
    {
      "name": "variable.other.property.coupl",
      "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*"
    },
    {
      "name": "keyword.operator.assignment.coupl",
      "match": "="
    },
    {
      "name": "punctuation.separator.coupl",
      "match": "[,\\.]"
    },
    {
      "name": "punctuation.section.coupl",
      "match": "[()\\[\\]{}]"
    }
  ]
}
