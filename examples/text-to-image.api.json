{
  "checkpoint": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "example.safetensors"
    }
  },
  "positive": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["checkpoint", 1],
      "text": "A small observatory above a sea of clouds, morning light"
    }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["checkpoint", 1],
      "text": "blurry, watermark"
    }
  },
  "latent": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 512,
      "height": 512,
      "batch_size": 1
    }
  },
  "sample": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["checkpoint", 0],
      "positive": ["positive", 0],
      "negative": ["negative", 0],
      "latent_image": ["latent", 0],
      "seed": 42,
      "steps": 20,
      "cfg": 7,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1
    }
  },
  "decoded": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["sample", 0],
      "vae": ["checkpoint", 2]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["decoded", 0],
      "filename_prefix": "Coupl"
    }
  }
}
